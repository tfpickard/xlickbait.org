# ---------------------------------------------------------------------------
# Generator environment.
#
# This file belongs OUTSIDE the repository on the machine that runs the cron --
# bin/run.sh reads $XLICKBAIT_ENV_FILE, defaulting to ~/.config/xlickbait/env.
# Nothing here ever goes into Netlify.
# ---------------------------------------------------------------------------

# Write-capable connection string for the Neon branch this generator writes to.
# Use the `main` branch in production. NOT the read-only role the website uses.
XLICKBAIT_DB_URL="postgresql://user:password@ep-example-123456.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

ANTHROPIC_API_KEY="sk-ant-..."
# Optional. Defaults to claude-sonnet-5.
XLICKBAIT_MODEL="claude-sonnet-5"

# Optional: purge the CDN after a successful run. Without both, new headlines
# simply appear as the cache TTL lapses.
# NETLIFY_PURGE_TOKEN="..."
# NETLIFY_SITE_ID="..."

# --- tuning, all optional ---
# XLICKBAIT_FRESH=3                  # clamped to 2-5
# XLICKBAIT_VINTAGE=4
# XLICKBAIT_CATEGORIES="cs.LG,astro-ph.HE"   # empty means all of arXiv
# XLICKBAIT_ARXIV_INTERVAL=3.0       # seconds; do not lower it
# XLICKBAIT_ID_BATCH=50              # candidates verified per id_list request
# XLICKBAIT_MAX_VINTAGE_ATTEMPTS=400
# XLICKBAIT_TRUTH_RETRIES=2
# XLICKBAIT_USER_AGENT="xlickbait/0.1 (+https://xlickbait.org; contact: you@example.com)"
