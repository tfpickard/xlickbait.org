# ---------------------------------------------------------------------------
# xlickbait.org -- web app environment
#
# Copy to .env for local development. .env is gitignored; never commit a real
# connection string.
# ---------------------------------------------------------------------------

# Pooled Neon connection string (host ends in `-pooler`). This is the only
# database variable the web app reads, and the only one ever set on Netlify.
# Scope it by deploy context there: the `main` branch URL for production, the
# `dev` branch URL for deploy previews and branch deploys.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection string -- same host without the `-pooler` suffix.
# Used ONLY by `bin/migrate.sh` and, later, the Python generator.
# NEVER set this in Netlify.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Hostname of the PRODUCTION (Neon `main` branch) endpoint. The seed and reset
# scripts refuse to run against it. Compared after stripping any `-pooler`
# suffix, so the pooled and direct forms of the same endpoint both match.
# A guard configured against an empty string protects nothing -- set this.
XLICKBAIT_PROD_DB_HOST="ep-example-123456.c-2.us-east-2.aws.neon.tech"

# Public origin, used for absolute URLs in the Atom feed and OG tags.
PUBLIC_SITE_URL="https://xlickbait.org"

# ---------------------------------------------------------------------------
# Headline illustrations (generator only -- NEVER set any of this on Netlify).
#
# Entirely optional. Without OPENROUTER_API_KEY the generator publishes exactly
# as before and the site draws its deterministic SVG thumbnails instead.
# ---------------------------------------------------------------------------

# https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Off switch that does not require deleting the key.
XLICKBAIT_IMAGES="1"

# Any model from https://openrouter.ai/api/v1/images/models. The default is the
# cheapest one that renders legible lettering: at quality "low" a 3:2 image bills
# around 270 output image tokens at $8/M, so roughly $0.002 apiece.
XLICKBAIT_IMAGE_MODEL="openai/gpt-image-1-mini"

# `tabloid` types the headline into the artwork, the way a supermarket front page
# does. `photo` renders the scene alone and forbids lettering outright -- pick it
# if you would rather not stake the joke on an image model's spelling.
XLICKBAIT_IMAGE_STYLE="tabloid"

# auto | low | medium | high. Models without a quality knob ignore it.
XLICKBAIT_IMAGE_QUALITY="low"
XLICKBAIT_IMAGE_ASPECT="3:2"

# The bytes live in Postgres, so this ceiling is the storage budget. An image
# that will not fit after the WebP quality walk is DROPPED, not truncated, and
# that headline keeps its SVG.
XLICKBAIT_IMAGE_MAX_WIDTH="1200"
XLICKBAIT_IMAGE_MAX_BYTES="400000"
XLICKBAIT_IMAGE_WEBP_QUALITY="82"

# A ceiling on ONE run's image spend, not a target. It exists so a typo in
# XLICKBAIT_IMAGE_MODEL -- a slug billing $0.12 an image instead of $0.002 --
# costs pennies rather than running unattended on cron. When OpenRouter does not
# report a cost, the run is billed ASSUMED_COST for that call rather than zero.
XLICKBAIT_IMAGE_BUDGET_USD="0.25"
XLICKBAIT_IMAGE_ASSUMED_COST_USD="0.01"
