{
	"name": "xlickbait",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "./bin/migrate.sh dev",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset-dev": "tsx scripts/reset-dev.ts",
		"og:build": "tsx scripts/build-og.ts",
		"test:built": "npm run build && vitest run tests/unit/built-function.test.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-xml-parser": "^5.11.1",
		"globals": "^17.6.0",
		"netlify-cli": "^27.8.0",
		"pg": "8.23.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true
	},
	"dependencies": {
		"@neondatabase/serverless": "1.1.0",
		"drizzle-orm": "1.0.0-rc.4"
	},
	"description": "A straight-faced tabloid front page for arXiv preprints.",
	"license": "MPL-2.0",
	"engines": {
		"node": ">=22.12"
	}
}
